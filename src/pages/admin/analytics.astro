---
import AdminLayout from "@/layouts/AdminLayout.astro";
import AdminPageHeader from "@/components/admin/AdminPageHeader.astro";
import AnalyticsDashboard from "@/lib/components/AnalyticsDashboard";
---

<AdminLayout title="Analytics" description="Pageview reporting plus external analytics provider setup for your public site.">
  <div class="space-y-6">
    <AdminPageHeader
      title="Analytics"
      description="Built-in first-party pageview reporting for public pages, plus settings for external analytics providers such as Google tag, Plausible, Umami, and Fathom."
    />
    <noscript>
      <div class="rounded-lg border border-destructive/20 bg-destructive/10 p-4 text-sm text-destructive">
        Analytics dashboard requires JavaScript. Please enable it to view metrics.
      </div>
    </noscript>
    <AnalyticsDashboard client:load />
  </div>
</AdminLayout>
