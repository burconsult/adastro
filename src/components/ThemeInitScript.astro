---
type Props = {
  themeStylesheetUrls?: Record<string, string>;
  themeFontStylesheetUrls?: Record<string, string>;
  legacyFontStylesheetUrl?: string | null;
};

const {
  themeStylesheetUrls = {},
  themeFontStylesheetUrls = {},
  legacyFontStylesheetUrl = null
} = Astro.props as Props;
---

<script
  is:inline
  define:vars={{
    themeStylesheetUrls,
    themeFontStylesheetUrls,
    legacyFontStylesheetUrl
  }}
>
  // Initialize theme as early as possible to avoid flash on first paint.
  (() => {
    try {
      const MODE_KEY = 'theme-mode';
      const LEGACY_MODE_KEY = 'theme';
      const PREVIEW_PRESET_KEY = 'theme-preview';
      const PREVIEW_MODE_KEY = 'theme-preview-mode';
      const root = document.documentElement;
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

      const allowModeLocal = root.dataset.themeModeLocal === 'true';

      const normalizeMode = (value) => {
        if (value === 'light' || value === 'dark' || value === 'system') return value;
        return null;
      };

      const serverPreset = typeof root.dataset.theme === 'string' && root.dataset.theme.trim().length > 0
        ? root.dataset.theme.trim()
        : 'adastro';
      const serverMode = normalizeMode(root.dataset.themeMode) || 'system';
      const previewPreset = localStorage.getItem(PREVIEW_PRESET_KEY)?.trim() || null;
      const previewMode = normalizeMode(localStorage.getItem(PREVIEW_MODE_KEY));

      const preset = previewPreset || serverPreset;
      const storedMode = allowModeLocal ? (localStorage.getItem(MODE_KEY) || localStorage.getItem(LEGACY_MODE_KEY)) : null;
      const modeSetting = previewMode || normalizeMode(storedMode) || serverMode;

      const ensureThemeAsset = (href, kind) => {
        if (!href || typeof href !== 'string') return;
        if (document.head.querySelector(`link[data-theme-asset="${kind}"][href="${href}"]`)) return;

        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = href;
        link.dataset.themeAsset = kind;
        document.head.appendChild(link);
      };

      if (previewPreset && previewPreset !== serverPreset) {
        const previewThemeHref = themeStylesheetUrls?.[previewPreset];
        const previewFontHref = themeFontStylesheetUrls?.[previewPreset]
          || (previewPreset !== 'adastro' ? legacyFontStylesheetUrl : null);

        ensureThemeAsset(previewThemeHref, 'theme-style');
        ensureThemeAsset(previewFontHref, 'theme-font');
      }

      if (previewPreset) {
        root.dataset.themePreview = 'true';
      } else {
        delete root.dataset.themePreview;
      }

      root.dataset.theme = preset;
      root.dataset.themeMode = modeSetting;

      let mode = modeSetting;
      if (mode !== 'dark' && mode !== 'light') {
        mode = prefersDark ? 'dark' : 'light';
      }
      root.classList.toggle('dark', mode === 'dark');
      root.style.colorScheme = mode === 'dark' ? 'dark' : 'light';

      if (allowModeLocal && !previewMode && (mode === 'dark' || mode === 'light')) {
        localStorage.setItem(MODE_KEY, modeSetting);
      }
    } catch {
      // Avoid blocking render on theme init failures.
    }
  })();
</script>
